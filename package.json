{
  "name": "@stephen-netu/design-system",
  "version": "0.3.1",
  "description": "KOS LEAP Design System — Neo-brutalist industrial UI with brass accent",
  "type": "module",
  "publishConfig": {
    "access": "public",
    "registry": "https://gitea.beast.ruun.network/api/packages/K-W/npm/"
  },
  "scripts": {
    "tokens:generate": "tsx scripts/generate-tokens-json.ts",
    "prebuild": "pnpm tokens:generate",
    "build": "svelte-package -i src -o dist",
    "postbuild": "pnpm tokens:generate",
    "changeset": "changeset",
    "version": "changeset version",
    "release": "pnpm build && changeset publish",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "check:layers": "node scripts/checks/import-graph.mjs",
    "check:tokens": "node scripts/checks/token-audit.mjs",
    "check:exports": "node scripts/checks/check-exports.mjs",
    "check:all": "pnpm check && pnpm check:layers && pnpm check:tokens && pnpm check:vite-pin",
    "check:vite-pin": "node -e \"const v=require('./package.json').devDependencies.vite;if(v!=='5.4.21'){console.error('vite pin violated: found '+v+', must stay at 5.4.21 (LEAP workspace standard — see LEAP/pnpm-workspace.yaml before bumping)');process.exit(1)}\""
  },
