{
  "name": "@stephen-netu/design-system",
  "version": "0.1.0",
  "description": "KOS LEAP Design System — HDA-organized frontend primitives",
  "type": "module",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "build": "svelte-package -i src -o dist",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "prepublishOnly": "pnpm check && pnpm build"
  },
  "files": [
    "dist/**/*.svelte",
    "dist/**/*.svelte.js",
    "dist/**/*.js",
    "dist/**/*.d.ts",
    "dist/**/*.d.ts.map",
    "dist/**/*.css",
    "src/**/*.css",
    "src/**/*.json",
    "package.json",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "svelte": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./*": "./dist/*"
  },
  "types": "./dist/index.d.ts",
  "sideEffects": ["**/*.css"],
  "peerDependencies": {
    "svelte": "^5.0.0"
  },
  "dependencies": {
    "@chenglou/pretext": "^0.0.5",
    "@codemirror/commands": "^6.10.0",
    "@codemirror/lang-markdown": "^6.2.0",
    "@codemirror/language": "^6.10.0",
    "@codemirror/language-data": "^6.5.2",
    "@codemirror/search": "^6.6.0",
    "@codemirror/state": "6.6.0",
    "@codemirror/view": "6.40.0",
    "codemirror": "^6.0.1",
    "d3-force": "^3.0.0",
    "elkjs": "^0.9.3",
    "force-graph": "^1.51.2",
    "graphology": "^0.25.4",
    "graphology-types": "^0.24.7",
    "leaflet": "^1.9.4",
    "perfect-arrows": "^0.3.7",
    "svelte-canvas": "^2.1.0"
  },
  "devDependencies": {
    "@lucide/svelte": "^1.17.0",
    "@sveltejs/package": "^2.5.7",
    "@sveltejs/vite-plugin-svelte": "^4.0.4",
    "@tsconfig/svelte": "^5.0.8",
    "@types/d3-force": "^3.0.10",
    "@types/leaflet": "^1.9.21",
    "svelte": "^5.55.0",
    "svelte-check": "^4.4.8",
    "typescript": "^5.9.3",
    "vite": "^5.4.0"
  },
  "packageManager": "pnpm@10.18.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/stephen-netu/kos-design-system.git"
  },
  "keywords": [
    "design-system",
    "svelte",
    "ui-components",
    "dark-theme"
  ],
  "author": "Stephen Netu",
  "license": "MIT"
}
