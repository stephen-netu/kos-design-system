#!/usr/bin/env bash
#
# Installed by: kos-repos install-peer-hooks <peer> (copied from .gears/gates/post-merge)
# WARNING: Edit this file, then re-run install-peer-hooks to propagate.
# Hand-edits to .githooks/post-merge will be overwritten on re-install.
#
# FAIL-LOUD CONTRACT (gate-veracity 2026-07-14):
# If a commit in the merged range carries a task-closing reference and the
# completion cannot be recorded (realm-substrate missing, daemon unreachable,
# mutation rejected), this hook MUST:
#   1. print a "KOS GATE FAILURE" line to stderr,
#   2. append the unprocessed sha + reason to $KOS_GATE_FAILURE_LOG
#      (default ~/.local/share/kos/gate-failures.log),
#   3. exit 1.
# It must never swallow a failed completion silently. git ignores post-merge
# exit codes, so stderr + the journal are the surfaced signal; the journal is
# the drift-sweep's replay queue. Fixture: .gears/gates/gate-fixtures.sh
# (post-merge positive/negative fixtures prove both sides of this contract).

set -uo pipefail

# True if the current repo is SOVEREIGN, worktree-safe (kos:sovereign-118799).
# `git rev-parse --show-toplevel` returns the *worktree* path for linked
# worktrees, so a basename check on it fails off the main checkout and Pass 3/4
# silently no-op there. Resolve the main repo via --git-common-dir and check its
# toplevel basename, with a remote-url fallback.
_repo_is_sovereign() {
  local top common main main_dir
  top="$(git rev-parse --show-toplevel 2>/dev/null || echo)"
  [[ "$(basename "$top")" == "SOVEREIGN" ]] && return 0
  common="$(git rev-parse --git-common-dir 2>/dev/null || echo)"
  [[ -z "$common" ]] && return 1
  # git-common-dir may be absolute or relative to the (worktree) toplevel.
  [[ "$common" == /* ]] && main_dir="$common" || main_dir="$top/$common"
  if [[ "$common" == *"/worktrees/"* ]]; then
    # .../<main>/.git/worktrees/<name> -> step up three to <main>
    main="$(cd "$main_dir/../../.." 2>/dev/null && pwd)" || return 1
  else
    main="$(cd "$main_dir/.." 2>/dev/null && pwd)" || return 1
  fi
  [[ "$(basename "$main")" == "SOVEREIGN" ]] && return 0
  git remote get-url origin 2>/dev/null | grep -qi sovereign && return 0
  return 1
}

FAIL_LOG="${KOS_GATE_FAILURE_LOG:-$HOME/.local/share/kos/gate-failures.log}"
HOOK_FAILED=0

gate_fail() {
  # $1 = reason, $2 = sha (optional)
  local ts
  ts="$(date -u +%Y-%m-%dT%H:%M:%SZ)"
  mkdir -p "$(dirname "$FAIL_LOG")" 2>/dev/null || true
  printf '%s post-merge repo=%s sha=%s reason=%s\n' \
    "$ts" "$(git rev-parse --show-toplevel 2>/dev/null || pwd)" "${2:-}" "$1" >> "$FAIL_LOG" 2>/dev/null || true
  printf 'KOS GATE FAILURE (post-merge): %s%s\n' "$1" "${2:+ [commit ${2}]}" >&2
  printf '  Task completion was NOT recorded. Journal: %s\n' "$FAIL_LOG" >&2
  HOOK_FAILED=1
}

# run_completion <sha> — invoke complete-from-commit and surface every failure
# mode: nonzero exit (binary/daemon/connect errors) AND per-task '✗' failure
# lines, which the binary prints while still exiting 0 (see
# s3-realm-substrate/src/commands/task.rs run_task_complete_from_commit).
run_completion() {
  local sha="$1" out rc
  out="$(realm-substrate task complete-from-commit "$sha" 2>&1)"
  rc=$?
  if [[ $rc -ne 0 ]]; then
    gate_fail "complete-from-commit exited $rc: $(printf '%s' "$out" | tail -n 3 | tr '\n' ' ')" "$sha"
  elif printf '%s\n' "$out" | grep -q '✗'; then
    gate_fail "complete-from-commit per-task failure: $(printf '%s\n' "$out" | grep '✗' | tr '\n' ' ')" "$sha"
  else
    printf '%s\n' "$out"
  fi
}

if ! git rev-parse --is-inside-work-tree >/dev/null 2>&1; then
  exit 0
fi

base="${ORIG_HEAD:-}"
if [[ -z "$base" ]]; then
  base="$(git rev-parse --verify --quiet HEAD^1 2>/dev/null || true)"
fi

if [[ -z "$base" ]]; then
  exit 0
fi

base_commit="$(git rev-parse --verify --quiet "${base}^{commit}" 2>/dev/null || true)"
if [[ -z "$base_commit" ]]; then
  exit 0
fi

commits="$(git rev-list --reverse "${base_commit}..HEAD" 2>/dev/null || true)"
if [[ -z "$commits" ]]; then
  exit 0
fi

# `refs <task-id>` means "this commit is ABOUT that task", not "this commit
# FINISHES it" (CLAUDE.md commit convention). This hook never treats `refs`
# as terminal, on main or anywhere else — auto-closing on a mere citation
# manufactures phantom completions (the 2026-06-10 sweep found 29). It was
# briefly kept behind a KOS_REFS_TERMINAL=1 opt-in (2026-07-14); that opt-in
# was deleted (kos:sovereign-1502) once it was confirmed redundant for the
# only path where landing-on-main genuinely means "complete" — kos-integrate
# closes the task itself after a verified merge (scripts/kos-integrate).
# closes/fixes remain the only terminal triggers, on every branch.
closing_ref='(^|[[:space:][:punct:]])(closes|fixes)[[:space:]]+(kos:)?[a-zA-Z][a-zA-Z0-9]*-[0-9]+'

# ── Pass 1: collect actionable work BEFORE requiring the binary, so a merge
#    with no closing references stays silent on machines without realm-substrate,
#    while a merge that NEEDS a completion fails loud when the binary is absent.
declare -a close_shas=()

while IFS= read -r sha; do
  [[ -z "$sha" ]] && continue

  parents="$(git rev-list --parents --max-count=1 "$sha" 2>/dev/null || true)"
  [[ -z "$parents" ]] && continue
  set -- $parents
  parent_count=$(($# - 1))
  [[ "$parent_count" -gt 1 ]] && continue

  message="$(git log --format=%B -n 1 "$sha" 2>/dev/null || true)"

  if printf '%s\n' "$message" | grep -Eiq "$closing_ref"; then
    close_shas+=("$sha")
  fi
done <<< "$commits"

if [[ ${#close_shas[@]} -gt 0 ]]; then
  if ! command -v realm-substrate >/dev/null 2>&1; then
    gate_fail "realm-substrate not on PATH; ${#close_shas[@]} closing commit(s) NOT recorded"
  else
    # ── Pass 2: execute, surfacing every failure.
    for sha in "${close_shas[@]}"; do
      run_completion "$sha"
    done
  fi
fi

# ── Pass 3: reconcile installed binaries to the freshly merged HEAD
#    (kos:sovereign-1557 follow-up). A merge to SOVEREIGN main changes source
#    but leaves the live binary stale until someone redeploys. Run a guarded
#    auto-refresh of every managed binary. Non-fatal: git ignores post-merge
#    exit codes, so we fail-LOUD to stderr + the journal when refresh is
#    refused while binaries are stale (same contract as Pass 2), but never
#    block the merge (the merge already happened).
#
# Deliberately NOT gated on close_shas being non-empty (kos:sovereign-1571):
# KOS convention (CLAUDE.md) mandates `refs`, never `closes`/`fixes`, in
# commit messages, so close_shas is empty on nearly every real merge — gating
# Pass 3 on it made the binary reconcile step unreachable in practice.
#
# KOS_ROOT: resolve relative to THIS script's on-disk location, not by
# walking up from the merged repo's toplevel — the previous `toplevel/../..`
# computation assumed a fixed nesting depth and silently pointed at the
# wrong directory (one level too high) when invoked from inside SOVEREIGN,
# making $REFRESH resolve to a nonexistent path (kos:sovereign-1571).
KOS_ROOT="${KOS_ROOT:-$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)}"
REFRESH="$KOS_ROOT/scripts/kos-binary-refresh"
if [[ -x "$REFRESH" ]] && _repo_is_sovereign; then
  if ! "$REFRESH" all >> "$FAIL_LOG" 2>&1; then
    gate_fail "kos-binary-refresh all refused after merge (mem/CI guard or build failure) — live binaries may be stale"
  else
    echo "[post-merge] managed binaries reconciled to HEAD via kos-binary-refresh all"
  fi
fi

# ── Pass 4: surface binary freshness drift on merge (warn-only).
#    A merge (or pull that fast-forwards) to SOVEREIGN main moves the reference
#    commit the freshness gate compares installed binaries against; if the live
#    binaries predate the new HEAD, a subsequent `--fail-on-drift` would gate
#    them red. Report that drift here, unconditionally and non-fatally.
#
#    Deliberately output-only: `--fail-on-drift` is contaminated by daemon
#    liveness (it also exits 1 when the daemon is unreachable), so using its
#    exit code would trip the fail-loud contract on every down-daemon merge.
#    We consume only its stdout (sed from 'Binary Freshness' on) and `|| true`
#    so a missing binary / down daemon cannot fail the hook. This is the gate
#    as a report, not as a gate. SOVEREIGN-only: drift is installed binaries
#    vs SOVEREIGN main, so only a SOVEREIGN merge can introduce either side.
if _repo_is_sovereign; then
  if command -v realm-substrate >/dev/null 2>&1; then
    echo "[post-merge] binary freshness vs merged HEAD:"
    realm-substrate status --fail-on-drift 2>&1 | sed -n '/Binary Freshness/,$p' || true
  else
    echo "[post-merge] realm-substrate not on PATH; skipping freshness drift report"
  fi
fi

exit "$HOOK_FAILED"
