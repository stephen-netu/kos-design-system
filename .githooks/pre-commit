#!/bin/bash
#
# Pre-commit hook — topological enforcement gate (peer version)
#
# Blocks .gears/ and .realm/ from being committed inside this peer repo.
# These directories belong at the KOS workspace root only.
#
# Canonical locations:
#   KOS/.gears/<project>/adr/  — project-scoped ADRs
#   KOS/.gears/_realm/         — cross-project docs
#   KOS/.realm/                — runtime state (locks, sockets, pids)
#
# See: realm-doc-topology-001
#
# WARNING: CANONICAL SOURCE — edit this file, then run 'kos-repos install-peer-hooks <repo>'
# to propagate. Hand-edits to .githooks/ will be overwritten on re-install.
# Installed by: kos-repos install-peer-hooks <repo>
#
# Also chains the T-02 Worktree Lifecycle gate (lifecycle-validate.sh).

set -euo pipefail

REPO_ROOT="$(git rev-parse --show-toplevel 2>/dev/null || echo "")"
if [ -z "$REPO_ROOT" ]; then
  REPO_ROOT="$(cd "$(dirname "$0")/../.." && pwd)"
fi

# Block .gears/ inside this peer repo
STRAY=$(git diff --cached --name-only --diff-filter=A 2>/dev/null | grep -E '^\.gears/' || true)
if [[ -n "$STRAY" ]]; then
    echo ""
    echo "TOPOLOGY VIOLATION: .gears/ staged inside $(basename "$REPO_ROOT")."
    echo ""
    echo "$STRAY" | sed 's/^/  /'
    echo ""
    echo "Canonical location: KOS/.gears/$(basename "$REPO_ROOT")/adr/ (or KOS/.gears/_realm/ for cross-project)."
    echo "See: realm-doc-topology-001"
    echo ""
    exit 1
fi

# Block .realm/ inside this peer repo
STRAY=$(git diff --cached --name-only --diff-filter=A 2>/dev/null | grep -E '^\.realm/' || true)
if [[ -n "$STRAY" ]]; then
    echo ""
    echo "TOPOLOGY VIOLATION: .realm/ staged inside $(basename "$REPO_ROOT")."
    echo ""
    echo "$STRAY" | sed 's/^/  /'
    echo ""
    echo "Canonical location: KOS/.realm/ (workspace root only)."
    echo "See: realm-doc-topology-001"
    echo ""
    exit 1
fi

# T-02: Worktree Lifecycle Integrity (lifecycle-validate.sh lives at KOS root).
kos_root=""
dir="$REPO_ROOT"
while [[ "$dir" != "/" ]]; do
  if [[ -f "$dir/.gears/repos.toml" ]]; then
    kos_root="$dir"
    break
  fi
  dir="$(dirname "$dir")"
done

if [[ -n "$kos_root" && -x "$kos_root/.gears/gates/lifecycle-validate.sh" ]]; then
  if ! "$kos_root/.gears/gates/lifecycle-validate.sh"; then
    echo "" >&2
    echo "COMMIT BLOCKED — T-02 worktree-lifecycle violation in $(basename "$REPO_ROOT") (above)." >&2
    echo "  Run /branch-sweep to reconcile, or bypass with --no-verify." >&2
    exit 1
  fi
fi

# Task-bound gate — kos:default-122748
# Refuse default-branch commits when KOS_TASK_ID is unset and .kos-session-env
# is absent. Catches sessions that work in the primary checkout and land commits
# directly on main, bypassing the worktree lifecycle (T-02).
gate_script="${REPO_ROOT}/.githooks/task-bound-gate.sh"
if [[ -x "$gate_script" ]]; then
  if ! "$gate_script"; then
    echo "" >&2
    echo "COMMIT BLOCKED — task-bound gate in $(basename "$REPO_ROOT") (above)." >&2
    echo "  Set KOS_TASK_ID, work in a worktree, or bypass with --no-verify." >&2
    exit 1
  fi
fi

# Rust backend gate — kos:sovereign-126970.
#
# Every Tauri peer here is a two-language app whose gate suite only covers the
# frontend: svelte-check never enters the Rust tree, so that half ships ungated.
# Ryu proved the cost — kos:sovereign-126890 added two fields to
# GetAllTasksParams, five construction sites stopped compiling, and four green
# gates plus an open PR said nothing.
#
# The manifest is RESOLVED, not hardcoded. An early draft keyed on
# "$REPO_ROOT/src-tauri/Cargo.toml" and was blind to LEAP, whose Tauri crate is
# at shell/src-tauri/ — the largest Rust peer, silently skipped. Instead, walk up
# from each staged .rs file to its nearest Cargo.toml and check those. That is
# correct for every layout: ryu/src-tauri, LEAP/shell/src-tauri, and member
# crates such as LEAP/lib/k3-logic.
#
# Inert where it does not apply: no staged .rs means no work, and a peer with no
# Rust at all (design-system) never resolves a manifest.
#
# bash 3.2 on macOS — no mapfile, no associative arrays.
if command -v cargo >/dev/null 2>&1; then
  staged_rs=$(git diff --cached --name-only --diff-filter=ACMR 2>/dev/null | grep '\.rs$' || true)
  if [[ -n "$staged_rs" ]]; then
    manifests=""
    while IFS= read -r f; do
      [[ -z "$f" ]] && continue
      d="$(dirname "$REPO_ROOT/$f")"
      while [[ "$d" != "/" && "$d" == "$REPO_ROOT"* ]]; do
        if [[ -f "$d/Cargo.toml" ]]; then
          manifests="$manifests$d/Cargo.toml"$'\n'
          break
        fi
        d="$(dirname "$d")"
      done
    done <<< "$staged_rs"

    for m in $(printf '%s' "$manifests" | sort -u); do
      if ! cargo check --manifest-path "$m" >&2; then
        echo "" >&2
        echo "COMMIT BLOCKED — cargo check failed for ${m#"$REPO_ROOT"/} (above)." >&2
        echo "  Fix the Rust backend, or bypass with --no-verify." >&2
        exit 1
      fi
    done
  fi
fi

exit 0
