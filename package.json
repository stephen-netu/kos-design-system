    "dist/**/*.svelte",
    "dist/**/*.svelte.js",
    "dist/**/*.js",
    "dist/**/*.d.ts",
    "dist/**/*.d.ts.map",
    "dist/**/*.css",
    "src/**/*.css",
    "src/**/*.json",
    "package.json",
    "README.md"
  ],
