#!/bin/bash
#
# Pre-push hook — topology + T-02 lifecycle enforcement (peer version)
#
# Blocks push if:
#   - .gears/ or .realm/ exist on disk inside this peer repo (T-01)
#   - any agent/*|feat/*|fix/* branch is prunable, fully-merged-but-not-deleted,
#     or stale without an active worktree (T-02)
#
# Checks the filesystem, not the staging area (which is always empty at push time).
#
# Cargo compilation is NOT checked here — Tauri peer apps depend on LEAP workspace
# path references and cannot be cargo-checked in isolation. Compilation gates live
# in each repo's .gitea/workflows/ci.yml.
#
# Installed by: kos-repos install-peer-hooks <repo>

set -euo pipefail

# REPO_ROOT = this peer repo's root (one level up from .githooks/)
REPO_ROOT="$(cd "$(dirname "$0")/.." && pwd)"
PEER_NAME="$(basename "$REPO_ROOT")"

# T-02: Worktree Lifecycle Integrity (lifecycle-validate.sh lives at KOS root).
# Cheap static check, runs before any network access. Walk up from this peer's
# .githooks/ to find KOS root, identified by .gears/repos.toml.
kos_root=""
dir="$REPO_ROOT"
while [[ "$dir" != "/" ]]; do
  if [[ -f "$dir/.gears/repos.toml" ]]; then
    kos_root="$dir"
    break
  fi
  dir="$(dirname "$dir")"
done

if [[ -n "$kos_root" && -x "$kos_root/.gears/gates/lifecycle-validate.sh" ]]; then
  if ! "$kos_root/.gears/gates/lifecycle-validate.sh"; then
    echo "" >&2
    echo "$PEER_NAME: PUSH BLOCKED — T-02 worktree-lifecycle violation (above)." >&2
    echo "  Run /branch-sweep to reconcile, or bypass with --no-verify." >&2
    exit 1
  fi
fi

# ── Topology gate: physical directory check ────────────────────────────────────
# At push time the staging area is empty — git diff --cached is always empty.
# Must check the filesystem instead.
if [[ -d "$REPO_ROOT/.gears" ]]; then
    echo ""
    echo "PUSH BLOCKED — TOPOLOGY VIOLATION: .gears/ exists inside $PEER_NAME."
    echo ""
    echo "  $REPO_ROOT/.gears"
    echo ""
    echo ".gears/ belongs only at the KOS workspace root. Delete it and retry."
    echo "See: realm-doc-topology-001"
    echo ""
    exit 1
fi
if [[ -d "$REPO_ROOT/.realm" ]]; then
    echo ""
    echo "PUSH BLOCKED — TOPOLOGY VIOLATION: .realm/ exists inside $PEER_NAME."
    echo ""
    echo "  $REPO_ROOT/.realm"
    echo ""
    echo ".realm/ belongs only at the KOS workspace root. Delete it and retry."
    echo "See: realm-doc-topology-001"
    echo ""
    exit 1
fi

exit 0
